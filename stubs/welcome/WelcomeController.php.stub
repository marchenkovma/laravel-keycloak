<?php

namespace App\Http\Controllers\Auth;

use App\Http\Controllers\Controller;
use Illuminate\Http\Request;
use Inertia\Inertia;
use Inertia\Response;

/**
 * Публичная страница с кнопкой «Войти»: сюда возвращают выход и неудавшийся
 * вход (keycloak.web.redirects). Сама вход не начинает, иначе форма Keycloak
 * открывается без спроса и устаревает. Заготовка пакета laravel-keycloak,
 * после публикации принадлежит проекту.
 */
class WelcomeController extends Controller
{
    public function __invoke(Request $request): Response
    {
        // Почему человек здесь: signed_out, session_expired или login_failed
        $notice = $request->session()->get('auth_notice');

        if (! in_array($notice, ['signed_out', 'session_expired', 'login_failed'], true)) {
            $notice = null;
        }

        return Inertia::render('Welcome', [
            'notice' => $notice,
            'texts' => [
                'title' => __('keycloak::messages.welcome.title'),
                'signIn' => __('keycloak::messages.welcome.sign_in'),
                'hint' => __('keycloak::messages.welcome.hint'),
                'notice' => $notice === null ? null : __('keycloak::messages.welcome.notice_'.$notice, [
                    'app' => config('app.name'),
                ]),
            ],
        ]);
    }
}
